{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "ANTHROPIC_BASE_URL": "http://localhost:4141",
    "ANTHROPIC_AUTH_TOKEN": "dummy",
    "ANTHROPIC_MODEL": "claude-sonnet-4.5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4.6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4.5",
    "ANTHROPIC_SMALL_FAST_MODEL": "gpt-5-mini",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4.6",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "allow": [
      "Edit", "Read", "Glob", "Grep", "Bash",
      "Edit(./.superdesign/**)", "Read(./.superdesign/**)",
      "Edit(./batches/**)", "Read(./batches/**)",
      "Edit(./development/**)","Read(./development/**)",
      "Edit(./meetings/**)","Read(./meetings/**)",
      "Edit(./transcripts/**)","Read(./transcripts/**)",
      "Edit(./research/**)","Read(./research/**)",
      "Edit(./scripts/**)", "Read(./scripts/**)",
      "Edit(./plans/**)", "Read(./plans/**)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_screenshot",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_wait",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:aws.amazon.com)",
      "mcp__google-search__search",
      "mcp__google-search__read_webpage"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["playwright", "google-search"],
  "alwaysThinkingEnabled": true,
  "plansDirectory": "./plans"
}