# Environment configuration
# Copy to .env and fill in values

# whisper.cpp binary (compiled with Metal support)
WHISPER_BIN=/usr/local/bin/whisper
WHISPER_MODEL=/usr/local/share/whisper/ggml-base.en.bin
WHISPER_THREADS=4
WHISPER_CONCURRENCY=1

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_LLM_MODEL=gemma3:1b-it-fp16

# ChromaDB HTTP server
CHROMA_URL=http://localhost:8000

# API server
PORT=3100
SERVER_URL=http://localhost:3100

# File watcher glob (relative to cwd or absolute)
TIMELINE_WATCH_GLOB=./data/timelines/**/*.json

# CLaRa: number of hypothetical excerpts to generate per query
CLARA_N_HYPOTHESES=4
