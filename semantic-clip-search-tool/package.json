{
  "name": "premiere-semantic-search",
  "version": "1.0.0",
  "type": "module",
  "description": "Semantic search over Premiere Pro timeline audio via whisper.cpp + Ollama + ChromaDB",
  "scripts": {
    "start": "tsx src/api/server.ts",
    "start:full": "bash scripts/start.sh",
    "stop:full": "bash scripts/stop.sh",
    "db:setup": "bash chromadb/setup.sh",
    "db:up": "tsx scripts/db.ts up",
    "db:down": "tsx scripts/db.ts down",
    "db:reset": "tsx scripts/db.ts reset",
    "db:status": "tsx scripts/db.ts status",
    "ollama:check": "tsx scripts/ollama-check.ts",
    "ollama:pull": "tsx scripts/ollama-check.ts --pull",
    "index": "tsx src/cli/index-cmd.ts",
    "search": "tsx src/cli/search-cmd.ts",
    "queue": "tsx src/cli/queue-status.ts",
    "test:queue": "tsx test/queue/queue-integration.ts",
    "test:eval": "tsx test/run-eval.ts",
    "test:eval:no-index": "tsx test/run-eval.ts --skip-index",
    "report:html": "tsx test/report/build-html.ts",
    "tui": "tsx src/cli/tui.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "chromadb": "^1.10.5",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
