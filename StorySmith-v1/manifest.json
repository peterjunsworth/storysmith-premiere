{
  "id": "StorySmith-v1",
  "name": "StorySmith",
  "shortname": "3pstarterplugin",
  "version": "1.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.3"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "https://4cbc-2601-740-8600-8a30-f8d8-6249-de40-ec68.ngrok-free.app",
        "http://localhost:3000",
        "http://localhost:3001",
        "http://localhost:3100",
        "https://*.ngrok-free.app",
        "https://*.adobe.com",
        "https://*.n8n.cloud",
        "https://peterjunsworth.app.n8n.cloud"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "starterpanel",
      "type": "panel",
      "minimumSize": {
        "width": 430,
        "height": 500
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 230,
        "height": 300
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 300
      },
      "label": {
        "default": "StorySmith - Semantic Search"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}